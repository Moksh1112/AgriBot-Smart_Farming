# Copy to ai/model.env and adjust paths/thresholds for your local setup.
# model.env is git-ignored — never commit real paths or secrets here.

# Path to the trained YOLO weights file.
# Place your downloaded .pt file in ai/models/weights/ and set the filename here.
MODEL_WEIGHTS_PATH=models/weights/best.pt

# Inference confidence threshold (0.0 - 1.0).
# Detections below this confidence are discarded.
CONFIDENCE_THRESHOLD=0.25

# Intersection over Union threshold used during non-max suppression.
# Lower values keep more overlapping boxes; higher values are stricter.
IOU_THRESHOLD=0.45

# Maximum number of detections per image.
MAX_DETECTIONS=300

# Save annotated output images to ai/runs/detect/.
# Set to false to only print results without saving images.
SAVE_OUTPUT=true
