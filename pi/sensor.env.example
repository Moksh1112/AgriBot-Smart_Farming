# Copy to pi/sensor.env and keep the real robot key private.
SENSOR_SERVER_HOST=0.0.0.0
SENSOR_SERVER_PORT=8000
AGRIBOT_BACKEND_URL=http://YOUR-BACKEND-LAN-IP:5000
ROBOT_INGEST_KEY=replace-with-the-same-key-as-backend/.env
ROBOT_LATITUDE=19.047838
ROBOT_LONGITUDE=72.872712

# MCP3008 channel assignments. Soil and pH are simulated by default.
SOIL_ADC_CHANNEL=0
RAIN_DO_PIN=27
PH_ADC_CHANNEL=2
# FC-37 DO is normally 0 when wet. Change to 1 only if your module reads backward.
RAIN_WET_DIGITAL_VALUE=0
SOIL_DRY_VALUE=0.75
SOIL_WET_VALUE=0.35

# Simulated readings shown in the dashboard until those analog probes are connected.
USE_FAKE_SOIL_MOISTURE=true
FAKE_SOIL_MOISTURE=48
USE_FAKE_PH=true
FAKE_PH=6.8

# Send a full reading to the backend automatically while this service runs.
AUTO_PUBLISH_ENABLED=true
PUBLISH_INTERVAL_SECONDS=30
