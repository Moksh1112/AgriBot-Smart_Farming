# Local development values. On a hosting platform set these as environment
# variables in its dashboard instead of uploading this file.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/agribot
JWT_SECRET=replace-with-a-long-random-development-secret
ROBOT_INGEST_KEY=replace-with-a-long-random-robot-key

# Production only: set NODE_ENV=production (enforces strong secrets).
# NODE_ENV=production
# Comma-separated allowed browser origins for CORS/Socket.IO ("*" = any).
# Phone apps and the Pi are not browsers and are unaffected.
# CORS_ORIGINS=*
# How long a farmer stays logged in (e.g. 30d, 12h).
# JWT_EXPIRES_IN=30d
# Optional comma-separated DNS servers for mongodb+srv lookups (e.g. 1.1.1.1,8.8.8.8).
# DNS_SERVERS=

# Development simulator only.
ROBOT_SIM_INTERVAL_MS=5000
# ROBOT_SIM_URL=http://127.0.0.1:5000
